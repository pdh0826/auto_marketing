generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogStatus {
  active
  inactive
}

enum CtaStrength {
  weak
  normal
  strong
}

enum ContentMode {
  seo_keyword
  service_promotion
  memo_expand
  existing_draft_improve
}

enum ContentStatus {
  idea
  planned
  drafted
  quality_review
  approved
  scheduled
  published
  failed
  rewrite_needed
}

enum ContentAssetType {
  image
  video
}

enum ContentAssetPlacement {
  hero
  intro
  middle
  outro
  gallery
  embed
}

enum LlmProviderType {
  openai
  local
  external_http
  local_http
  cli
}

enum LlmInvocationMode {
  external_http
  local_http
  cli
}

enum LlmApiFormat {
  openai_compatible
  ollama_compatible
  custom_http
  custom_cli
}

enum LlmProviderTestStatus {
  untested
  success
  failed
}

enum LlmTaskType {
  provider_test
  content_plan
  content_draft
  html_convert
  quality_check
  style_rewrite
  cta_generate
  keyword_analyze
  serp_analyze
  image_analyze
}

enum LlmCallStatus {
  success
  failed
}

enum BloggerConnectionStatus {
  not_configured
  configured
  oauth_required
  connected
  expired
  error
}

enum BloggerSecretKind {
  oauth_client_secret
  access_token
  refresh_token
}

enum BloggerDraftApprovalStatus {
  approved
  revoked
  superseded
}

enum BloggerDraftSaveStatus {
  success
  failed
}

enum BloggerPublishApprovalMode {
  publish
  scheduled_publish
}

enum BloggerPublishApprovalStatus {
  approved_snapshot
  invalidated
  used_for_publish_attempt
  used_for_schedule_attempt
  cancelled
}

enum BloggerPublishExecutionAttemptStatus {
  planned_only
  blocked_by_preflight
  success
}

enum ContentDraftGenerationRunStatus {
  pending
  running
  failed
  completed
  cancelled
}

enum ContentDraftGenerationStepStatus {
  pending
  running
  success
  failed
  skipped
}

model Blog {
  id                     String      @id @default(cuid())
  name                   String
  url                    String
  bloggerBlogId          String?
  mainTopic              String?
  subTopics              String[]    @default([])
  targetReader           String?
  tone                   String?
  locale                 String      @default("ko-KR")
  forbiddenPhrases       String[]    @default([])
  preferredPhrases       String[]    @default([])
  defaultContentLength   Int         @default(1200)
  defaultCtaStrength     CtaStrength @default(normal)
  dailyPublishLimit      Int         @default(1)
  nightExcludeStart      String?
  nightExcludeEnd        String?
  autoPublishEnabled     Boolean     @default(false)
  manualApprovalRequired Boolean     @default(true)
  status                 BlogStatus  @default(active)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  contentItems       ContentItem[]
  bloggerConnections BloggerConnection[]

  @@index([status])
  @@map("blogs")
}

model BrandProfile {
  id               String   @id @default(cuid())
  name             String
  serviceName      String?
  shortDescription String?
  longDescription  String?
  targetUsers      String[] @default([])
  coreFeatures     String[] @default([])
  problemsSolved   String[] @default([])
  mainUrl          String?
  ctaWeak          String?
  ctaNormal        String?
  ctaStrong        String?
  forbiddenPhrases String[] @default([])
  preferredPhrases String[] @default([])
  riskDisclaimer   String?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contentItems ContentItem[]

  @@index([isDefault])
  @@map("brand_profiles")
}

model ContentItem {
  id             String        @id @default(cuid())
  blogId         String?
  brandProfileId String?
  mode           ContentMode
  status         ContentStatus @default(idea)
  title          String?
  targetKeyword  String?
  sourceMemo     String?
  planJson       Json?
  draftMarkdown  String?
  draftHtml      String?
  qualityScore   Int?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  blog                               Blog?                                   @relation(fields: [blogId], references: [id], onDelete: SetNull)
  brandProfile                       BrandProfile?                           @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  llmCallLogs                        LlmCallLog[]
  assets                             ContentAsset[]
  bloggerDraftApprovals              BloggerDraftApproval[]
  bloggerDraftSaves                  BloggerDraftSave[]
  bloggerPublishApprovals            BloggerPublishApproval[]
  bloggerPublishExecutionAttempts    BloggerPublishExecutionAttempt[]
  draftGenerationRuns                ContentDraftGenerationRun[]
  dailyContentOperatorApprovals      BlogDailyContentOperatorApproval[]
  dailyContentOperatorApprovalEvents BlogDailyContentOperatorApprovalEvent[]

  @@index([blogId])
  @@index([brandProfileId])
  @@index([status])
  @@index([mode])
  @@map("content_items")
}

model ContentAsset {
  id            String                @id @default(cuid())
  contentItemId String
  assetType     ContentAssetType
  fileName      String
  originalName  String
  mimeType      String
  fileSize      Int
  storagePath   String
  thumbnailPath String?
  caption       String?
  altText       String?
  userNote      String?
  placementHint ContentAssetPlacement @default(gallery)
  sortOrder     Int                   @default(0)
  isPrimary     Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
  @@index([assetType])
  @@index([placementHint])
  @@index([isPrimary])
  @@map("content_assets")
}

model LlmProvider {
  id                  String                @id @default(cuid())
  providerType        LlmProviderType
  invocationMode      LlmInvocationMode     @default(external_http)
  apiFormat           LlmApiFormat          @default(openai_compatible)
  name                String
  baseUrl             String?
  endpointPath        String?
  defaultModel        String?
  headersJson         Json?
  requestTemplateJson Json?
  cliExecutable       String?
  cliArgsJson         Json?
  secretRef           String?
  apiKeyLast4         String?
  isEnabled           Boolean               @default(true)
  timeoutSeconds      Int                   @default(60)
  maxRetries          Int                   @default(1)
  lastTestStatus      LlmProviderTestStatus @default(untested)
  lastTestedAt        DateTime?
  lastTestError       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  models         LlmModel[]
  primaryRoutes  LlmTaskRoute[]      @relation("PrimaryProvider")
  fallbackRoutes LlmTaskRoute[]      @relation("FallbackProvider")
  callLogs       LlmCallLog[]
  secrets        LlmProviderSecret[]

  @@index([providerType])
  @@index([invocationMode])
  @@index([apiFormat])
  @@index([isEnabled])
  @@index([lastTestStatus])
  @@map("llm_providers")
}

model LlmProviderSecret {
  id             String   @id @default(cuid())
  providerId     String
  secretKind     String
  encryptedValue String
  keyVersion     String   @default("v1")
  apiKeyLast4    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider LlmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, secretKind])
  @@index([providerId])
  @@map("llm_provider_secrets")
}

model LlmModel {
  id          String   @id @default(cuid())
  providerId  String
  name        String
  displayName String?
  isDefault   Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider       LlmProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  primaryRoutes  LlmTaskRoute[] @relation("PrimaryModel")
  fallbackRoutes LlmTaskRoute[] @relation("FallbackModel")
  callLogs       LlmCallLog[]

  @@unique([providerId, name])
  @@index([isEnabled])
  @@map("llm_models")
}

model LlmTaskRoute {
  id                 String      @id @default(cuid())
  taskType           LlmTaskType @unique
  primaryProviderId  String
  primaryModelId     String
  fallbackProviderId String?
  fallbackModelId    String?
  temperature        Float?
  maxTokens          Int?
  timeoutSeconds     Int?
  isEnabled          Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  primaryProvider  LlmProvider  @relation("PrimaryProvider", fields: [primaryProviderId], references: [id])
  primaryModel     LlmModel     @relation("PrimaryModel", fields: [primaryModelId], references: [id])
  fallbackProvider LlmProvider? @relation("FallbackProvider", fields: [fallbackProviderId], references: [id])
  fallbackModel    LlmModel?    @relation("FallbackModel", fields: [fallbackModelId], references: [id])

  @@index([isEnabled])
  @@map("llm_task_routes")
}

model LlmCallLog {
  id            String        @id @default(cuid())
  taskType      LlmTaskType
  providerId    String?
  modelId       String?
  contentItemId String?
  status        LlmCallStatus
  latencyMs     Int?
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Decimal?      @db.Decimal(10, 6)
  errorMessage  String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  provider    LlmProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  model       LlmModel?    @relation(fields: [modelId], references: [id], onDelete: SetNull)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([taskType])
  @@index([status])
  @@index([createdAt])
  @@index([contentItemId])
  @@map("llm_call_logs")
}

model ContentDraftGenerationRun {
  id                         String                          @id @default(cuid())
  contentItemId              String
  strategy                   String
  status                     ContentDraftGenerationRunStatus @default(pending)
  currentStepKey             String?
  sectionKeys                Json
  assembledCandidateMarkdown String?
  finalCandidateMarkdown     String?
  validationSummary          Json?
  metadata                   Json?
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  completedAt                DateTime?

  contentItem ContentItem                  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  steps       ContentDraftGenerationStep[]

  @@index([contentItemId])
  @@index([strategy])
  @@index([status])
  @@index([currentStepKey])
  @@index([createdAt])
  @@map("content_draft_generation_runs")
}

model ContentDraftGenerationStep {
  id             String                           @id @default(cuid())
  runId          String
  stepKey        String
  sectionKey     String?
  status         ContentDraftGenerationStepStatus @default(pending)
  attempt        Int                              @default(1)
  outputMarkdown String?
  outputSummary  String?
  promptHash     String?
  responseHash   String?
  latencyMs      Int?
  errorCode      String?
  metadata       Json?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  run ContentDraftGenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([stepKey])
  @@index([sectionKey])
  @@index([status])
  @@index([createdAt])
  @@map("content_draft_generation_steps")
}

model BloggerConnection {
  id                    String                  @id @default(cuid())
  blogId                String?
  name                  String
  status                BloggerConnectionStatus @default(not_configured)
  bloggerBlogId         String?
  bloggerBlogName       String?
  bloggerBlogUrl        String?
  bloggerBlogVerifiedAt DateTime?
  connectedEmail        String?
  scopes                String[]                @default([])
  oauthClientIdRef      String?
  clientSecretRef       String?
  hasClientSecret       Boolean                 @default(false)
  hasAccessToken        Boolean                 @default(false)
  hasRefreshToken       Boolean                 @default(false)
  tokenLast4            String?
  lastTestedAt          DateTime?
  lastError             String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  blog        Blog?                     @relation(fields: [blogId], references: [id], onDelete: SetNull)
  oauthStates BloggerOAuthState[]
  secrets     BloggerConnectionSecret[]

  @@index([blogId])
  @@index([status])
  @@index([bloggerBlogId])
  @@index([bloggerBlogVerifiedAt])
  @@map("blogger_connections")
}

model BloggerDraftApproval {
  id                          String                     @id @default(cuid())
  contentItemId               String
  status                      BloggerDraftApprovalStatus @default(approved)
  snapshotHash                String
  draftHtmlHash               String
  titleCandidate              String
  targetBloggerBlogId         String
  targetBloggerBlogName       String?
  targetBloggerBlogUrl        String?
  targetBloggerBlogVerifiedAt DateTime
  readinessSummaryJson        Json
  approvedAt                  DateTime                   @default(now())
  approvedBy                  String?
  revokedAt                   DateTime?
  revokedReason               String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  contentItem      ContentItem              @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  draftSaves       BloggerDraftSave[]
  publishApprovals BloggerPublishApproval[]

  @@index([contentItemId])
  @@index([status])
  @@index([snapshotHash])
  @@index([approvedAt])
  @@map("blogger_draft_approvals")
}

model BloggerDraftSave {
  id                     String                 @id @default(cuid())
  contentItemId          String
  approvalId             String
  bloggerConnectionId    String
  status                 BloggerDraftSaveStatus
  snapshotHash           String
  draftHtmlHash          String
  targetBloggerBlogId    String
  targetBloggerBlogName  String?
  targetBloggerBlogUrl   String?
  titleCandidate         String
  bloggerPostId          String?
  bloggerPostUrl         String?
  bloggerPostPublishedAt DateTime?
  bloggerPostUpdatedAt   DateTime?
  errorCode              String?
  errorMessage           String?
  retryable              Boolean                @default(false)
  savedAt                DateTime?
  failedAt               DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  contentItem      ContentItem              @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  approval         BloggerDraftApproval     @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  publishApprovals BloggerPublishApproval[]

  @@index([contentItemId])
  @@index([approvalId])
  @@index([status])
  @@index([snapshotHash])
  @@index([savedAt])
  @@map("blogger_draft_saves")
}

model BloggerPublishApproval {
  id                              String                       @id @default(cuid())
  contentItemId                   String
  mode                            BloggerPublishApprovalMode
  status                          BloggerPublishApprovalStatus @default(approved_snapshot)
  targetBloggerBlogId             String
  targetBloggerBlogName           String?
  targetBloggerBlogUrl            String?
  bloggerPostId                   String
  bloggerDraftSaveId              String?
  bloggerDraftApprovalId          String?
  draftMarkdownHash               String
  draftHtmlHash                   String
  draftHtmlLength                 Int
  titleCandidate                  String?
  scheduledAt                     DateTime?
  timezone                        String?
  snapshotJson                    Json
  snapshotHash                    String
  hashAlgorithm                   String
  canonicalization                String
  rollbackAcknowledged            Boolean                      @default(false)
  sideEffectSummaryAcknowledged   Boolean                      @default(false)
  approvalPersistenceAcknowledged Boolean                      @default(false)
  tokenState                      String
  tokenStateCheckedAt             DateTime
  createdBy                       String?
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  invalidatedAt                   DateTime?
  invalidatedReason               String?
  supersededByApprovalId          String?

  contentItem          ContentItem                      @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  bloggerDraftSave     BloggerDraftSave?                @relation(fields: [bloggerDraftSaveId], references: [id], onDelete: SetNull)
  bloggerDraftApproval BloggerDraftApproval?            @relation(fields: [bloggerDraftApprovalId], references: [id], onDelete: SetNull)
  executionAttempts    BloggerPublishExecutionAttempt[]

  @@index([contentItemId])
  @@index([bloggerPostId])
  @@index([targetBloggerBlogId])
  @@index([snapshotHash])
  @@index([status])
  @@index([createdAt])
  @@index([invalidatedAt])
  @@index([mode])
  @@index([scheduledAt])
  @@map("blogger_publish_approvals")
}

model BloggerPublishExecutionAttempt {
  id                          String                               @id @default(cuid())
  contentItemId               String
  publishApprovalId           String
  publishApprovalSnapshotHash String
  mode                        BloggerPublishApprovalMode
  status                      BloggerPublishExecutionAttemptStatus @default(planned_only)
  attemptNumber               Int                                  @default(1)
  targetBloggerBlogId         String?
  bloggerPostId               String?
  draftHtmlHash               String?
  titleCandidate              String?
  tokenStateAtAttempt         String?
  executionGuardCheckedAt     DateTime
  approvalMatchesCurrentState Boolean?
  invalidationCandidatesJson  Json
  sideEffectSummaryJson       Json
  bloggerRequestSummaryJson   Json?
  bloggerResponseRedactedJson Json?
  errorType                   String?
  errorCode                   String?
  errorMessageRedacted        String?
  retryEligible               Boolean                              @default(false)
  retryBlockedReason          String?
  contentMutationPlanned      Boolean                              @default(false)
  contentMutationCompleted    Boolean                              @default(false)
  contentStatusBefore         String?
  contentStatusAfter          String?
  publishedAtPlanned          DateTime?
  publishedAtApplied          DateTime?
  scheduledAtPlanned          DateTime?
  scheduledAtApplied          DateTime?
  attemptPlanJson             Json
  attemptPlanHash             String
  hashAlgorithm               String
  canonicalization            String
  createdAt                   DateTime                             @default(now())
  updatedAt                   DateTime                             @updatedAt

  contentItem     ContentItem            @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  publishApproval BloggerPublishApproval @relation(fields: [publishApprovalId], references: [id], onDelete: Restrict)

  @@unique([contentItemId, publishApprovalId, attemptPlanHash])
  @@index([contentItemId])
  @@index([publishApprovalId])
  @@index([publishApprovalSnapshotHash])
  @@index([attemptPlanHash])
  @@index([status])
  @@index([mode])
  @@index([createdAt])
  @@map("blogger_publish_execution_attempts")
}

model BlogOperationProfile {
  id                               String   @id @default(cuid())
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
  targetBloggerBlogId              String
  targetBloggerBlogName            String?
  targetBloggerBlogUrl             String?
  profileName                      String   @default("Default")
  status                           String   @default("active")
  operationMode                    String   @default("approval_required")
  defaultPublishPolicyPreset       String   @default("safe_manual_publish")
  timezone                         String   @default("Asia/Seoul")
  allowAutoPublish                 Boolean  @default(false)
  allowScheduledPublish            Boolean  @default(false)
  requireOAuthGate                 Boolean  @default(true)
  requireFinalHumanApproval        Boolean  @default(true)
  requireExternalWriteRiskAck      Boolean  @default(true)
  requireRollbackPlanAck           Boolean  @default(true)
  requireReadbackAfterPublish      Boolean  @default(true)
  requirePostPublishReconciliation Boolean  @default(true)
  maxPostsPerDay                   Int?
  defaultPublishWindowStart        String?
  defaultPublishWindowEnd          String?
  policyJson                       Json?
  guardrailJson                    Json?
  exceptionRoutingJson             Json?

  @@unique([targetBloggerBlogId])
  @@index([status])
  @@index([defaultPublishPolicyPreset])
  @@index([operationMode])
  @@map("blog_operation_profiles")
}

model BlogDailyContentPlan {
  id                         String   @id @default(cuid())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  targetBloggerBlogId        String
  targetBloggerBlogName      String?
  targetBloggerBlogUrl       String?
  operationProfileId         String?
  planDateLocal              String
  timezone                   String   @default("Asia/Seoul")
  planName                   String   @default("Daily Content Plan")
  status                     String   @default("draft")
  planKind                   String   @default("daily_auto_content_plan")
  operationMode              String   @default("approval_required")
  defaultPublishPolicyPreset String   @default("safe_manual_publish")
  contentGenerationEnabled   Boolean  @default(false)
  llmCallEnabled             Boolean  @default(false)
  publishExecutionEnabled    Boolean  @default(false)
  scheduledPublishEnabled    Boolean  @default(false)
  plannedItemCount           Int      @default(0)
  policySnapshotJson         Json?
  planSummaryJson            Json?
  guardrailJson              Json?

  items                  BlogDailyContentPlanItem[]
  operatorApprovals      BlogDailyContentOperatorApproval[]
  operatorApprovalEvents BlogDailyContentOperatorApprovalEvent[]

  @@unique([targetBloggerBlogId, planDateLocal])
  @@index([targetBloggerBlogId])
  @@index([planDateLocal])
  @@index([status])
  @@index([defaultPublishPolicyPreset])
  @@map("blog_daily_content_plans")
}

model BlogDailyContentPlanItem {
  id                      String   @id @default(cuid())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  planId                  String
  itemOrder               Int
  slotKey                 String
  status                  String   @default("candidate")
  topicSeed               String
  contentIntent           String
  audienceHint            String?
  riskNote                String?
  publishMode             String   @default("approval_required")
  contentItemId           String?
  draftGenerationAllowed  Boolean  @default(false)
  llmGenerationAllowed    Boolean  @default(false)
  publishExecutionAllowed Boolean  @default(false)
  scheduledPublishAllowed Boolean  @default(false)
  requiresHumanApproval   Boolean  @default(true)
  policySnapshotJson      Json?
  itemPlanJson            Json?

  plan                   BlogDailyContentPlan                    @relation(fields: [planId], references: [id], onDelete: Cascade)
  operatorApprovals      BlogDailyContentOperatorApproval[]
  operatorApprovalEvents BlogDailyContentOperatorApprovalEvent[]

  @@index([planId])
  @@index([status])
  @@index([contentItemId])
  @@map("blog_daily_content_plan_items")
}

model BlogDailyContentOperatorApproval {
  id String @id @default(cuid())

  planId        String
  planItemId    String
  contentItemId String

  approvalPurpose      String
  approvalStatus       String
  operatorAction       String?
  operatorLabel        String?
  operatorNoteRedacted String?

  riskAcknowledged              Boolean @default(false)
  externalWriteRiskAcknowledged Boolean @default(false)
  llmExecutionAcknowledged      Boolean @default(false)
  contentMutationAcknowledged   Boolean @default(false)
  bloggerWriteAcknowledged      Boolean @default(false)

  approvalPolicyPreset String?
  operationMode        String?

  guardrailSnapshotJson     Json?
  readinessSnapshotJson     Json?
  sideEffectExpectationJson Json?

  approvedAt DateTime?
  heldAt     DateTime?
  rejectedAt DateTime?
  revokedAt  DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdByOperatorId String?
  updatedByOperatorId String?

  idempotencyKey String

  plan        BlogDailyContentPlan                    @relation(fields: [planId], references: [id])
  planItem    BlogDailyContentPlanItem                @relation(fields: [planItemId], references: [id])
  contentItem ContentItem                             @relation(fields: [contentItemId], references: [id])
  events      BlogDailyContentOperatorApprovalEvent[]

  @@unique([idempotencyKey])
  @@index([planId, createdAt])
  @@index([planItemId, approvalPurpose])
  @@index([contentItemId, approvalPurpose])
  @@index([approvalStatus, approvalPurpose])
  @@index([approvalPurpose, createdAt])
  @@map("blog_daily_content_operator_approvals")
}

model BlogDailyContentOperatorApprovalEvent {
  id String @id @default(cuid())

  approvalId    String
  planId        String
  planItemId    String
  contentItemId String

  eventType            String
  fromStatus           String?
  toStatus             String
  operatorAction       String?
  operatorNoteRedacted String?

  requestId      String?
  idempotencyKey String

  guardrailSnapshotJson     Json?
  readinessSnapshotJson     Json?
  sideEffectExpectationJson Json?

  createdAt           DateTime @default(now())
  createdByOperatorId String?

  approval    BlogDailyContentOperatorApproval @relation(fields: [approvalId], references: [id])
  plan        BlogDailyContentPlan             @relation(fields: [planId], references: [id])
  planItem    BlogDailyContentPlanItem         @relation(fields: [planItemId], references: [id])
  contentItem ContentItem                      @relation(fields: [contentItemId], references: [id])

  @@unique([idempotencyKey])
  @@index([approvalId, createdAt])
  @@index([planId, createdAt])
  @@index([planItemId, createdAt])
  @@index([contentItemId, createdAt])
  @@index([eventType, createdAt])
  @@map("blog_daily_content_operator_approval_events")
}

model BloggerConnectionSecret {
  id             String            @id @default(cuid())
  connectionId   String
  secretKind     BloggerSecretKind
  encryptedValue String
  keyVersion     String            @default("v1")
  last4          String?
  tokenType      String?
  scopes         String[]          @default([])
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  connection BloggerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, secretKind])
  @@index([connectionId])
  @@index([secretKind])
  @@index([expiresAt])
  @@map("blogger_connection_secrets")
}

model BloggerOAuthState {
  id           String    @id @default(cuid())
  connectionId String
  stateHash    String    @unique
  redirectUri  String
  scopes       String[]  @default([])
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  connection BloggerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([expiresAt])
  @@map("blogger_oauth_states")
}
